# ==========================================
# NCMS 환경 변수 샘플 (git 추적용 — 비밀 값 제외)
# 이 파일을 복사해 .env로 만들고 실제 값을 채워넣으세요.
# ==========================================

# Spring 프로파일 (local / prod)
SPRING_PROFILES_ACTIVE=local

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=ncms
PGUSER=postgres
PGPASSWORD=your_password_here

# JWT & CORS (CORS_ALLOWED_ORIGINS 은 쉼표로 구분)
JWT_SECRET=your-secret-key-must-be-at-least-256-bits-long
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://ncms-production.up.railway.app
